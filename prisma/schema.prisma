generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Certificate {
  id            String   @id @default(cuid())
  certificateId String   @unique
  recipient     String
  title         String
  issuer        String
  issuedAt      DateTime @default(now())
  qrCode        String?
  status        String   @default("VERIFIED")
}